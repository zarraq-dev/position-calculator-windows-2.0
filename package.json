{
  "name": "position-calculator-windows-2.0",
  "version": "1.0.0",
  "description": "Position size calculator for trading",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:electron && electron .",
    "build": "tsc",
    "build:electron": "npm run build && npm run bundle:renderer && npm run copy:assets",
    "bundle:renderer": "node build-renderer.js",
    "copy:assets": "copyfiles -u 1 \"src/renderer/**/*.html\" \"src/renderer/**/*.css\" dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "trading",
    "calculator",
    "electron",
    "position-size"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "^2.4.1",
    "electron": "^39.2.3",
    "esbuild": "^0.27.0",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
